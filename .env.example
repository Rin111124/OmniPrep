# Copy to .env for Docker Compose. Replace all placeholders locally.
# Never commit a populated .env file.

# ASP.NET Core API and Worker
ConnectionStrings__Supabase="Host=<db-host>;Port=5432;Database=postgres;Username=<db-user>;Password=<db-password>;SSL Mode=Require"
Supabase__Url=https://<project-ref>.supabase.co
Gemini__ApiKey=<gemini-api-key>

# Public frontend origin(s), comma-separated, no trailing slash.
Cors__AllowedOrigins=https://staging.example.vn
Frontend__Url=https://staging.example.vn

# Frontend build/runtime configuration. These values are public in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
OMNIPREP_API_URL=http://api:8080/api

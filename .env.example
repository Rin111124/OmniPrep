# ============================================================
# OmniPrep - Environment variables
# ============================================================

# 1. GOOGLE GEMINI API (set only on .NET API/Worker; the browser never receives this key)
# Lấy API key tại: https://aistudio.google.com/app/apikey
Gemini__ApiKey=your_gemini_api_key_here

# 2. SUPABASE (Database PostgreSQL + pgvector + Supabase Auth)
# Tạo dự án miễn phí tại: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase PostgreSQL Connection String (Dành cho Backend .NET & pgvector)
# Lấy tại Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
SUPABASE_CONNECTION_STRING="Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.your-project;Password=your-db-password;SSL Mode=Require"

# .NET configuration variables (set these in the API and Worker process environments)
ConnectionStrings__Supabase="Host=db.your-project.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=your-db-password;SSL Mode=Require"
Supabase__Url=https://your-project-id.supabase.co

# 3. Backend URL for the Next.js server-side proxy (never expose credentials here)
OMNIPREP_API_URL=http://localhost:5000/api

